.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
vite.config.ts
**/.vscode-test.*

.docs/**
.sisyphus/**
screenshot/**
AGENTS.md

# 内部工具目录与本地生成文件不打包
.codegraph/**
.opencode/**
.slim/**
.sisyphus/**
.ignore

# 构建/开发脚本不打包（build-and-install.js 仅本地安装用）
scripts/**

node_modules/**

# webview 子包整体不打包（源码与依赖已由 vite 打包进 out/webview/assets/main.js）
webview/**

# webview 构建产物保留（out/webview/** 默认随 out/ 包含，此处显式声明以防后续调整）
!out/webview/**
